<% layout("layouts/boilerplate") %>

<body>
    <div class="home">

         <section class="center">
     
           <form action="/home/search" method="POST">
              <h3>Find the space that defines you</h3>
              <div class="box">
                 <p>Enter location <span>*</span></p>
                 <input type="text" name="location" required maxlength="50" placeholder="Enter City name" class="input">
              </div>
              <div class="flex">
                 <div class="box">
                    <p>Property type <span></span></p>
                    <select name="property_type" class="input" >
                        <option value="">Select Type</option>
                        <option value="Flats">Flats</option>
                        <option value="Apartment">Apartment</option>
                        <option value="House">House</option>
                        <option value="Shops&Malls">Shops & Malls</option>
                        <option value="Villa">Villa</option>
                        <option value="Independent-house">Independent House</option>
                        <option value="Bungloo">Bungloo</option>
                        <option value="Buildings">Buildings</option>
                    </select>
                 </div>
                 <div class="box">
                    <p>How many BHK <span>*</span></p>
                    <select name="bhk" class="input" required>
                       <option value="1">1 BHK</option>
                       <option value="2">2 BHK</option>
                       <option value="3">3 BHK</option>
                       <option value="4">4 BHK</option>
                       <option value="5">5 BHK</option>
                       <option value="6">6 BHK</option>
                       <option value="7">7 BHK</option>
                       <option value="8">8 BHK</option>
                       <option value="9">9 BHK</option>
                    </select>
                 </div>
                 <div class="box">
                    <p>Minimum budget <span>*</span></p>
                    <select name="min_budget" class="input" required>
                       <option value="500000">5 lac</option>
                       <option value="1000000">10 lac</option>
                       <option value="2000000">20 lac</option>
                       <option value="3000000">30 lac</option>
                       <option value="4000000">40 lac</option>
                       <option value="5000000">50 lac</option>
                       <option value="6000000">60 lac</option>
                       <option value="7000000">70 lac</option>
                       <option value="8000000">80 lac</option>
                       <option value="9000000">90 lac</option>
                       <option value="10000000">1 Cr</option>
                       <option value="20000000">2 Cr</option>
                       <option value="30000000">3 Cr</option>
                       <option value="40000000">4 Cr</option>
                       <option value="50000000">5 Cr</option>
                       <option value="60000000">6 Cr</option>
                       <option value="70000000">7 Cr</option>
                       <option value="80000000">8 Cr</option>
                       <option value="90000000">9 Cr</option>
                       <option value="100000000">10 Cr</option>
                       <option value="150000000">15 Cr</option>
                       <option value="200000000">20 Cr</option>
                    </select>
                 </div>
                 <div class="box">
                    <p>Maximum budget <span>*</span></p>
                    <select name="max_budget" class="input" required>
                       <option value="1000000">10 lac</option>
                       <option value="2000000">20 lac</option>
                       <option value="3000000">30 lac</option>
                       <option value="4000000">40 lac</option>
                       <option value="5000000">50 lac</option>
                       <option value="6000000">60 lac</option>
                       <option value="7000000">70 lac</option>
                       <option value="8000000">80 lac</option>
                       <option value="9000000">90 lac</option>
                       <option value="10000000">1 Cr</option>
                       <option value="20000000">2 Cr</option>
                       <option value="30000000">3 Cr</option>
                       <option value="40000000">4 Cr</option>
                       <option value="50000000">5 Cr</option>
                       <option value="60000000">6 Cr</option>
                       <option value="70000000">7 Cr</option>
                       <option value="80000000">8 Cr</option>
                       <option value="90000000">9 Cr</option>
                       <option value="100000000">10 Cr</option>
                       <option value="150000000">15 Cr</option>
                       <option value="200000000">20 Cr</option>
                    </select>
                 </div>
              </div>
              <input type="submit" value="search property" name="search" class="btn submit-btn">
           </form>
     
        </section>
     
     </div>
     
     <!-- home section ends -->
     
     <!-- services section starts  -->
     
     <section class="services">
     
        <h1 class="heading">Our services</h1>
     
        <div class="box-container">
     
         <a href="/home/listings" class="anchor">
           <div class="box">
              <img src="https://res.cloudinary.com/dwzzzllfr/image/upload/v1732470913/icon-1_szxc8j.png" alt="#">
              <h3>Buy house</h3>
              <p>Buy your dream house today—affordable, secure, modern, and trusted homes.</p>
           </div>
         </a>
     
         <a href="/home/listings/rent" class="anchor">
            <div class="box">
               <img src="https://res.cloudinary.com/dwzzzllfr/image/upload/v1732470912/icon-2_hc8w0j.png" alt="#">
               <h3>Rent house</h3>
               <p>Spacious, affordable rental home with modern amenities in prime location.</p>
            </div>
         </a>

           <a href="/home/new" class="anchor">
               <div class="box">
                  <img src="https://res.cloudinary.com/dwzzzllfr/image/upload/v1732470912/icon-3_q7ohw3.png" alt="#">
                  <h3>Sell house</h3>
                  <p>Modern, spacious home with garden—perfect for family living. Call today!</p>
               </div>
            </a>
  
            <a href="/home/listings/flats&buildings" class="anchor">
               <div class="box">
                  <img src="https://res.cloudinary.com/dwzzzllfr/image/upload/v1732470912/icon-4_kwxdkd.png" alt="#">
                  <h3>Flats and Buildings</h3>
                  <p>Spacious, modern flats and buildings designed for comfort and convenience.</p>
               </div>
            </a>
        
            <a href="/home/listings/shops&malls" class="anchor">
               <div class="box">
                  <img src="https://res.cloudinary.com/dwzzzllfr/image/upload/v1732470912/icon-2_hc8w0j.png" alt="#">
                  <h3>Shops and Malls</h3>
                  <p>Discover a variety of shops and malls. Experience the finest!</p>
               </div>
            </a>
     
            <a href="/home/contactUs" class="anchor">
               <div class="box" >
                  <img src="https://res.cloudinary.com/dwzzzllfr/image/upload/v1732470912/icon-6_qwih1e.png" alt="#">
                  <h3>24/7 Services</h3>
                  <p>Offering round-the-clock, 24/7 service to ensure uninterrupted support, anytime.</p>
               </div>
            </a>
     
        </div>
     
     </section>
     
     <!-- services section ends -->
     
     <!-- listings section starts  -->
   
     <section class="listings">
     
        <h1 class="heading">Latest Listings</h1>
     
        <div class="box-container">
         
         <% for (let i = 0; i < Math.min(allListing.length, 6); i++) { %>
            <div class="box">
               <div class="admin">
                  <h3> <%= allListing[i].owner.username.charAt(0).toUpperCase() %></h3>
                  <div>
                     <p>Presented by <%= allListing[i].owner.firstname%></p>
                     <span> <%= allListing[i].date %> </span>
                  </div>
               </div>
               <div class="thumb">
                  <p class="total-images"><i class="far fa-image"></i><span><%= allListing[i].images.length %></span></p>
                  <p class="type"><span> <%= allListing[i].property_type %></span>  
                     <span> <%= allListing[i].property_for %> </span>
                  </p>
                  
                  <!-- <form action="" method="post" class="save">
                     <button type="submit" name="save" class="far fa-heart"></button>
                  </form> -->
                  <img src=<%= allListing[i].mainImage.url  %> alt="#">
               </div>
         
               <h3 class="name"><%= allListing[i].title %></h3>
               <p class="location"><i class="fas fa-map-marker-alt"></i><span> <%= allListing[i].address.locality %>, <%= allListing[i].address.city %>, <%= allListing[i].address.country %></span></p>
         
               <div class="flex">
                  <p><i class="fas fa-bed"></i><span> <%= allListing[i].details.bedroom %> </span></p>
                  <p><i class="fas fa-bath"></i><span> <%= allListing[i].details.bathroom %> </span></p>
                  <p><i class="fas fa-maximize"></i><span> <%= allListing[i].details.carpetArea %> sq.ft </span></p>
               </div>
               <a href="/home/listings/<%= allListing[i]._id %>" class="a-btn">Take a look  &nbsp; <i class="fa-solid fa-arrow-right-long" style="color: #11828d;"></i></a>
            </div>
         <% } %>
         
     
        </div>
     
        <div style="margin-top: 2rem; text-align:center;">
           <a href="/home/listings" class="inline-btn view-btn">view all</a>
        </div>
        
     
     </section>
</body>